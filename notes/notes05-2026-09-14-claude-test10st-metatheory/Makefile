# Claude: build the Lean that tests/test10st.ott generates, and check the
# metatheory statements against it.
#
#   make             generate test10st.lean and check both files
#   make test10st.lean    just the generated module
#   make clean
#
# ott is expected to have been built at the top of this checkout ("make world"
# there), and lean to be on the PATH, which for an elan installation means
# ~/.elan/bin - an interactive shell has it, a bare "env -i make" does not.

OTT  = ../../bin/ott
TEST = test10st
TEST_DIR = ../../tests/
LEAN ?= lean

.PHONY: all clean

all: $(TEST)-metatheory.olean

# the $(TEST).lean file is generated by ott from the $(TEST).ott file
# the $(TEST)-metatheory.lean is generated by the ott lean_filter from the $(TEST)-metatheory.mng file, which replaces ott syntax in [[ ]] with the corresonding lean syntax as defined by the $(TEST).ott grammar
# Claude: a grouped target (GNU make 4.3 and later), since the single ott run
# writes both files; with a plain multi-target rule make would run it once per
# target and $@ would name the wrong output
$(TEST).lean $(TEST)-metatheory.lean &: $(TEST_DIR)$(TEST).ott $(TEST)-metatheory.mng
	$(OTT) -i $(TEST_DIR)$(TEST).ott -o $(TEST).lean -lean_filter $(TEST)-metatheory.mng $(TEST)-metatheory.lean

$(TEST).olean: $(TEST).lean
	$(LEAN) -o $@ $<



# Claude: LEAN_PATH so that the "import test10st" in the .mng resolves against
# the module built here
$(TEST)-metatheory.olean: $(TEST)-metatheory.lean $(TEST).olean
	LEAN_PATH=. $(LEAN) -o $@ $<

clean:
	rm -f $(TEST).lean $(TEST)-metatheory.lean $(TEST).olean $(TEST)-metatheory.olean
