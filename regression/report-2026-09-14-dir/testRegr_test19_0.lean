  | Ty_Abs : ∀ (G5 : G) (x : termvar) (T1 : T) (t2 : t) (T2 : T),
      (Ty (G_term G5 x T1) t2 T2) →
      Ty G5 (t_Lam x T1 t2) (T_Fun T1 T2)

  | Ty_App : ∀ (G5 : G) (t1 : t) (t2 : t) (T12 : T) (T11 : T),
      (Ty G5 t1 (T_Fun T11 T12)) →
      (Ty G5 t2 T11) →
      Ty G5 (t_App t1 t2) T12

  | Ty_Let : ∀ (G5 : G) (p5 : p) (t1 : t) (t2 : t) (T2 : T) (T1 : T) (D : G),
      (Ty G5 t1 T1) →
      (Pat p5 T1 D) →
      (Ty (flatten_G ((app_list_G (Cons_list_G G5 Nil_list_G) (app_list_G (Cons_list_G D Nil_list_G) Nil_list_G)))) t2 T2) →
      Ty G5 (t_Let p5 t1 t2) T2

  | Ty_Rcd : ∀ (l_t_T_list : list_label_t_T) (G5 : G),
      (∀ l_t_T_list_ ∈ (unmake_list_label_t_T l_t_T_list), (fun (l_,t_,T_) => (Ty G5 t_ T_)) l_t_T_list_) →
      Ty G5 (t_Rec (make_list_label_t (map_list_label_t_T (fun l_ t_ T_ => (l_,t_)) l_t_T_list))) (T_Rec (make_list_label_T (map_list_label_t_T (fun l_ t_ T_ => (l_,T_)) l_t_T_list)))

  | Ty_Proj : ∀ (l_T_list : list_label_T) (j : index) (G5 : G) (t5 : t),
      (Ty G5 t5 (T_Rec l_T_list)) →
      Ty G5 (t_Proj t5 ((fun (l_,T_) => l_) ((unmake_list_label_T l_T_list)[j - 1]!))) ((fun (l_,T_) => T_) ((unmake_list_label_T l_T_list)[j - 1]!))

  | Ty_Sub : ∀ (G5 : G) (t5 : t) (T5 : T) (S : T),
      (Ty G5 t5 S) →
      (SA G5 S T5) →
      Ty G5 t5 T5


/-- defn Pat -/
inductive Pat : p → T → G → Prop where
  | Pat_Var : ∀ (x : termvar) (T5 : T),
      Pat (P_Var x T5) T5 (G_term G_empty x T5)

  | Pat_Rcd : ∀ (l_p_T_D_list : list_label_p_T_G),
      (∀ l_p_T_D_list_ ∈ (unmake_list_label_p_T_G l_p_T_D_list), (fun (l_,p_,T_,D_) => (Pat p_ T_ D_)) l_p_T_D_list_) →
      Pat (P_Rec (make_list_label_p (map_list_label_p_T_G (fun l_ p_ T_ D_ => (l_,p_)) l_p_T_D_list))) (T_Rec (make_list_label_T (map_list_label_p_T_G (fun l_ p_ T_ D_ => (l_,T_)) l_p_T_D_list))) (flatten_G (make_list_G (map_list_label_p_T_G (fun l_ p_ T_ D_ => D_) l_p_T_D_list)))


end
inductive list_label_p_s : Type where
    | Nil_list_label_p_s : list_label_p_s
    | Cons_list_label_p_s : label -> p -> s -> list_label_p_s -> list_label_p_s
  deriving Inhabited
open list_label_p_s

def map_list_label_p_s {A : Type} (f : label -> p -> s -> A) (l : list_label_p_s) : List A :=
  match l with
  | Nil_list_label_p_s => []
  | Cons_list_label_p_s h0 h1 h2 tl_ => (f h0 h1 h2) :: (map_list_label_p_s f tl_)

def make_list_label_p_s (l : List (label × p × s)) : list_label_p_s :=
  match l with
  | [] => Nil_list_label_p_s
  | (h0,h1,h2) :: tl_ => Cons_list_label_p_s h0 h1 h2 (make_list_label_p_s tl_)

def unmake_list_label_p_s (l : list_label_p_s) : List (label × p × s) :=
  match l with
  | Nil_list_label_p_s => []
  | Cons_list_label_p_s h0 h1 h2 tl_ => (h0,h1,h2) :: (unmake_list_label_p_s tl_)

def nth_list_label_p_s (n : Nat) (l : list_label_p_s) : Option (label × p × s) :=
  match n, l with
  | 0, Cons_list_label_p_s h0 h1 h2 tl_ => some (h0,h1,h2)
  | 0, _ => none
  | _+1, Nil_list_label_p_s => none
  | k+1, Cons_list_label_p_s _ _ _ tl_ => nth_list_label_p_s k tl_

def app_list_label_p_s (l m : list_label_p_s) : list_label_p_s :=
  match l with
  | Nil_list_label_p_s => m
  | Cons_list_label_p_s h0 h1 h2 tl_ => Cons_list_label_p_s h0 h1 h2 (app_list_label_p_s tl_ m)

/- definitions -/


/- defns Jop -/
mutual
/-- defn reduce -/
inductive reduce : t → t → Prop where
  | reduce_AppAbs : ∀ (x : termvar) (T11 : T) (t12 : t) (v2 : t),
      (is_v_of_t v2) →
      reduce (t_App (t_Lam x T11 t12) v2) (tsubst_t v2 x t12)

  | reduce_LetV : ∀ (p5 : p) (t2 : t) (s5 : s) (v1 : t),
      (is_v_of_t v1) →
      (is_v_of_t v1) →
      (M p5 v1 s5) →
      reduce (t_Let p5 v1 t2) (m_t_subst_t s5 t2)

  | reduce_ProjRcd : ∀ (l'_v_list : list_label_t) (j : index),
      (List.all (unmake_list_label_t l'_v_list) (fun (l'_,v_) => is_v_of_t v_)) →
      reduce (t_Proj (t_Rec l'_v_list) ((fun (l'_,v_) => l'_) ((unmake_list_label_t l'_v_list)[j - 1]!))) ((fun (l'_,v_) => v_) ((unmake_list_label_t l'_v_list)[j - 1]!))

  | reduce_Ctx_app_fun : ∀ (t1 : t) (t_5 : t) (t1' : t),
      (reduce t1 t1') →
      reduce (t_App t1 t_5) (t_App t1' t_5)

  | reduce_Ctx_app_arg : ∀ (v5 : t) (t1 : t) (t1' : t),
      (is_v_of_t v5) →
      (reduce t1 t1') →
      reduce (t_App v5 t1) (t_App v5 t1')

  | reduce_Ctx_record : ∀ (l'_t'_list : list_label_t) (l_v_list : list_label_t) (l : label) (t5 : t) (t' : t),
      (List.all (unmake_list_label_t l_v_list) (fun (l_,v_) => is_v_of_t v_)) →
      (reduce t5 t') →
      reduce (t_Rec ((app_list_label_t l_v_list (app_list_label_t (Cons_list_label_t l t5 Nil_list_label_t) (app_list_label_t l'_t'_list Nil_list_label_t))))) (t_Rec ((app_list_label_t l_v_list (app_list_label_t (Cons_list_label_t l t' Nil_list_label_t) (app_list_label_t l'_t'_list Nil_list_label_t)))))

  | reduce_Ctx_let_binding : ∀ (p5 : p) (t1 : t) (t2 : t) (t1' : t),
      (reduce t1 t1') →
      reduce (t_Let p5 t1 t2) (t_Let p5 t1' t2)


/-- defn M -/
inductive M : p → t → s → Prop where
  | M_Var : ∀ (x : termvar) (T5 : T) (v5 : t),
      (is_v_of_t v5) →
      (is_v_of_t v5) →
      M (P_Var x T5) v5 (S_singleton x v5)

  | M_Rcd : ∀ (l_p_s_list : list_label_p_s) (k_v_list : list_label_t) (i : index) (m : index) (j : index) (n : index),
      (List.all (unmake_list_label_t k_v_list) (fun (k_,v_) => is_v_of_t v_)) →
      (forall i, (1<= i /\ i <= m) -> exists j, (1<= j /\ j <= n) -> (((((fun (l_,p_,s_) => l_) ((unmake_list_label_p_s l_p_s_list)[i - 1]!)) = ((fun (k_,v_) => k_) ((unmake_list_label_t k_v_list)[j - 1]!))) /\ M ((fun (l_,p_,s_) => p_) ((unmake_list_label_p_s l_p_s_list)[i - 1]!)) ((fun (k_,v_) => v_) ((unmake_list_label_t k_v_list)[j - 1]!)) ((fun (l_,p_,s_) => s_) ((unmake_list_label_p_s l_p_s_list)[i - 1]!))))) →
      M (P_Rec (make_list_label_p (map_list_label_p_s (fun l_ p_ s_ => (l_,p_)) l_p_s_list))) (t_Rec k_v_list) (S_list (make_list_s (map_list_label_p_s (fun l_ p_ s_ => s_) l_p_s_list)))


end


