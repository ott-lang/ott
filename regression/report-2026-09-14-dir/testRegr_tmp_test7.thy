| Tin_2I: "\<lbrakk>Tin (X) (U) (G)\<rbrakk> \<Longrightarrow>
Tin (X) (U) ((G_type G X' U'))"

| Tin_3I: "\<lbrakk>Tin (X) (U) (G)\<rbrakk> \<Longrightarrow>
Tin (X) (U) ((G_term G x' T'))"
(** definitions *)
(* defns Jtype *)
inductive Gok :: "G \<Rightarrow> bool"
 and GT :: "G \<Rightarrow> T \<Rightarrow> bool"
 and SA :: "G \<Rightarrow> T \<Rightarrow> T \<Rightarrow> bool"
 and SAf :: "G \<Rightarrow> label \<Rightarrow> T \<Rightarrow> (label*T) list \<Rightarrow> bool"
 and Ty :: "G \<Rightarrow> t \<Rightarrow> T \<Rightarrow> bool"
 and Pat :: "p \<Rightarrow> T \<Rightarrow> G \<Rightarrow> bool"
where
(* defn Gok *)

Gok_1I: "Gok (G_empty)"

| Gok_2I: "\<lbrakk>GT (G) (T) ;
 Not(   (  xinG (x) (G)  )   ) \<rbrakk> \<Longrightarrow>
Gok ((G_term G x T))"

| Gok_3I: "\<lbrakk>GT (G) (T) ;
 Not(   (  XinG (X) (G)  )   ) \<rbrakk> \<Longrightarrow>
Gok ((G_type G X T))"

| (* defn GT *)

GT_VarI: "\<lbrakk>Gok (G) ;
Tin (X) (U) (G)\<rbrakk> \<Longrightarrow>
GT (G) ((Ty_Var X))"

| GT_TopI: "\<lbrakk>Gok (G)\<rbrakk> \<Longrightarrow>
GT (G) (Ty_Top)"

| GT_FunI: "\<lbrakk>GT (G) (T) ;
GT (G) (T')\<rbrakk> \<Longrightarrow>
GT (G) ((Ty_Fun T T'))"

| GT_ForallI: "\<lbrakk>GT ((G_type G X T)) (T')\<rbrakk> \<Longrightarrow>
GT (G) ((Ty_Forall X T T'))"

| GT_RcdI: "\<lbrakk>(List.list_all (% b . b) ((List.map (%((l_XXX::label),(T_XXX::T)).GT (G) (T_XXX)) l_T_list)))\<rbrakk> \<Longrightarrow>
GT (G) ((Ty_Rec (l_T_list)))"

| (* defn SA *)

SA_TopI: "\<lbrakk>Gok (G)\<rbrakk> \<Longrightarrow>
SA (G) (S) (Ty_Top)"

| SA_Refl_TVarI: "\<lbrakk>Gok (G)\<rbrakk> \<Longrightarrow>
SA (G) ((Ty_Var X)) ((Ty_Var X))"

| SA_Trans_TVarI: "\<lbrakk>Tin (X) (U) (G) ;
SA (G) (U) (T)\<rbrakk> \<Longrightarrow>
SA (G) ((Ty_Var X)) (T)"

| SA_ArrowI: "\<lbrakk>SA (G) (T1) (S1) ;
SA (G) (S2) (T2)\<rbrakk> \<Longrightarrow>
SA (G) ((Ty_Fun S1 S2)) ((Ty_Fun T1 T2))"

| SA_AllI: "\<lbrakk>SA (G) (T1) (S1) ;
SA ((G_type G X T1)) (S2) (T2)\<rbrakk> \<Longrightarrow>
SA (G) ((Ty_Forall X S1 S2)) ((Ty_Forall X T1 T2))"

| SA_RcdI: "\<lbrakk> ! i  . ((1::nat)<= i  &  i <= m ) ==>  SAf (G) (((%(k_XXX,S_XXX) . k_XXX) (List.nth k_S_list (i - 1)))) (((%(k_XXX,S_XXX) . S_XXX) (List.nth k_S_list (i - 1)))) ((l_T_list)) \<rbrakk> \<Longrightarrow>
SA (G) ((Ty_Rec (k_S_list))) ((Ty_Rec (l_T_list)))"

| (* defn SAf *)

SAf_foundI: "\<lbrakk>SA (G) (S) (T)\<rbrakk> \<Longrightarrow>
SAf (G) (k) (S) (([(k,T)] @ l_T_list))"

| SAf_skipI: "\<lbrakk>SAf (G) (k) (S) ((l_T_list))\<rbrakk> \<Longrightarrow>
SAf (G) (k) (S) (([(l,T)] @ l_T_list))"

| (* defn Ty *)

TyCh_VarI: "\<lbrakk>Gok (G) ;
tin (x) (T) (G)\<rbrakk> \<Longrightarrow>
Ty (G) ((t_Var x)) (T)"

| TyCh_AbsI: "\<lbrakk>Ty ((G_term G x T1)) (t2) (T2)\<rbrakk> \<Longrightarrow>
Ty (G) ((t_Lam x T1 t2)) ((Ty_Fun T1 T2))"

| TyCh_AppI: "\<lbrakk>Ty (G) (t1) ((Ty_Fun T11 T12)) ;
Ty (G) (t2) (T11)\<rbrakk> \<Longrightarrow>
Ty (G) ((t_App t1 t2)) (T12)"

| TyCh_TAbsI: "\<lbrakk>Ty ((G_type G X T1)) (t2) (T2)\<rbrakk> \<Longrightarrow>
Ty (G) ((t_TLam X T1 t2)) ((Ty_Forall X T1 T2))"

| TyCh_TAppI: "\<lbrakk>Ty (G) (t1) ((Ty_Forall X T11 T12)) ;
SA (G) (T2) (T11)\<rbrakk> \<Longrightarrow>
Ty (G) ((t_TApp t1 T2)) ( (Tsubst_T  T2   X   T12 ) )"

| TyCh_LetI: "\<lbrakk>Ty (G) (t1) (T1) ;
Pat (p) (T1) (D) ;
Ty ( (flatten_G  ([(G)] @ [(D)]) ) ) (t2) (T2)\<rbrakk> \<Longrightarrow>
Ty (G) ((t_Let p t1 t2)) (T2)"

| TyCh_RcdI: "\<lbrakk>(List.list_all (% b . b) ((List.map (%((l_XXX::label),(t_XXX::t),(T_XXX::T)).Ty (G) (t_XXX) (T_XXX)) l_t_T_list)))\<rbrakk> \<Longrightarrow>
Ty (G) ((t_Rec ((List.map (%((l_XXX::label),(t_XXX::t),(T_XXX::T)).(l_XXX,t_XXX)) l_t_T_list)))) ((Ty_Rec ((List.map (%((l_XXX::label),(t_XXX::t),(T_XXX::T)).(l_XXX,T_XXX)) l_t_T_list))))"

| TyCh_ProjI: "\<lbrakk>Ty (G) (t) ((Ty_Rec (l_T_list)))\<rbrakk> \<Longrightarrow>
Ty (G) ((t_Proj t ((%(l_XXX,T_XXX) . l_XXX) (List.nth l_T_list (j - 1))))) (((%(l_XXX,T_XXX) . T_XXX) (List.nth l_T_list (j - 1))))"

| TyCh_SubI: "\<lbrakk>Ty (G) (t) (S) ;
SA (G) (S) (T)\<rbrakk> \<Longrightarrow>
Ty (G) (t) (T)"

| (* defn Pat *)

Pat_VarI: "Pat ((P_Var x T)) (T) ((G_term G_empty x T))"

| Pat_RcdI: "\<lbrakk>(List.list_all (% b . b) ((List.map (%((l_XXX::label),(p_XXX::p),(T_XXX::T),(D_XXX::G)).Pat (p_XXX) (T_XXX) (D_XXX)) l_p_T_D_list)))\<rbrakk> \<Longrightarrow>
Pat ((P_Rec ((List.map (%((l_XXX::label),(p_XXX::p),(T_XXX::T),(D_XXX::G)).(l_XXX,p_XXX)) l_p_T_D_list)))) ((Ty_Rec ((List.map (%((l_XXX::label),(p_XXX::p),(T_XXX::T),(D_XXX::G)).(l_XXX,T_XXX)) l_p_T_D_list)))) ( (flatten_G  ((List.map (%((l_XXX::label),(p_XXX::p),(T_XXX::T),(D_XXX::G)).D_XXX) l_p_T_D_list)) ) )"
(** definitions *)
(* defns Jop *)
inductive reduce :: "t \<Rightarrow> t \<Rightarrow> bool"
 and M :: "p \<Rightarrow> t \<Rightarrow> s \<Rightarrow> bool"
 and Mf :: "label \<Rightarrow> p \<Rightarrow> (label*t) list \<Rightarrow> s \<Rightarrow> bool"
where
(* defn reduce *)

reduce_AppAbsI: "\<lbrakk>is_v_of_t v2\<rbrakk> \<Longrightarrow>
reduce ((t_App  (t_Lam x T11 t12)  v2)) ( ( tsubst_t  v2   x   t12  ) )"

| reduce_TappTabsI: "reduce ((t_TApp  (t_TLam X T11 t12)  T2)) ( ( Tsubst_t  T2   X   t12  ) )"

| reduce_LetVI: "\<lbrakk>is_v_of_t v1 ;
is_v_of_t v1 ;
M (p) (v1) (s)\<rbrakk> \<Longrightarrow>
reduce ((t_Let p v1 t2)) ( ( m_t_subst_t  s   t2  ) )"

| reduce_ProjRcdI: "\<lbrakk>List.list_all (%(l'_XXX,v_XXX). is_v_of_t v_XXX) l'_v_list\<rbrakk> \<Longrightarrow>
reduce ((t_Proj (t_Rec (l'_v_list)) ((%(l'_XXX,v_XXX) . l'_XXX) (List.nth l'_v_list (j - 1))))) (((%(l'_XXX,v_XXX) . v_XXX) (List.nth l'_v_list (j - 1))))"

| reduce_Ctx_app_funI: "\<lbrakk>reduce (t1) (t1')\<rbrakk> \<Longrightarrow>
reduce ((t_App t1 t)) ((t_App t1' t))"

| reduce_Ctx_app_argI: "\<lbrakk>is_v_of_t v ;
reduce (t1) (t1')\<rbrakk> \<Longrightarrow>
reduce ((t_App v t1)) ((t_App v t1'))"

| reduce_Ctx_type_funI: "\<lbrakk>reduce (t1) (t1')\<rbrakk> \<Longrightarrow>
reduce ((t_TApp t1 T)) ((t_TApp t1' T))"

| reduce_Ctx_recordI: "\<lbrakk>List.list_all (%(l_XXX,v_XXX). is_v_of_t v_XXX) l_v_list ;
reduce (t) (t')\<rbrakk> \<Longrightarrow>
reduce ((t_Rec (l_v_list @ [(l,t)] @ l'_t'_list))) ((t_Rec (l_v_list @ [(l,t')] @ l'_t'_list)))"

| reduce_Ctx_let_bindingI: "\<lbrakk>reduce (t1) (t1')\<rbrakk> \<Longrightarrow>
reduce ((t_Let p t1 t2)) ((t_Let p t1' t2))"

| (* defn M *)

M_VarI: "\<lbrakk>is_v_of_t v ;
is_v_of_t v\<rbrakk> \<Longrightarrow>
M ((P_Var x T)) (v) ( [ ( x , v ) ] )"

| M_RcdI: "\<lbrakk>List.list_all (%(k_XXX,v_XXX). is_v_of_t v_XXX) k_v_list ;
 ! i  . ((1::nat)<= i  &  i <= m ) ==>  Mf (((%(l_XXX,p_XXX,s_XXX) . l_XXX) (List.nth l_p_s_list (i - 1)))) (((%(l_XXX,p_XXX,s_XXX) . p_XXX) (List.nth l_p_s_list (i - 1)))) ((k_v_list)) (((%(l_XXX,p_XXX,s_XXX) . s_XXX) (List.nth l_p_s_list (i - 1)))) \<rbrakk> \<Longrightarrow>
M ((P_Rec ((List.map (%((l_XXX::label),(p_XXX::p),(s_XXX::s)).(l_XXX,p_XXX)) l_p_s_list)))) ((t_Rec (k_v_list))) ( List.concat  ((List.map (%((l_XXX::label),(p_XXX::p),(s_XXX::s)).s_XXX) l_p_s_list)) )"

| (* defn Mf *)

Mf_foundI: "\<lbrakk>is_v_of_t v ;
List.list_all (%(k_XXX,v_XXX). is_v_of_t v_XXX) k_v_list ;
M (p) (v) (s)\<rbrakk> \<Longrightarrow>
Mf (l) (p) (([(l,v)] @ k_v_list)) (s)"

| Mf_skipI: "\<lbrakk>is_v_of_t v ;
List.list_all (%(k_XXX,v_XXX). is_v_of_t v_XXX) k_v_list ;
Mf (l) (p) ((k_v_list)) (s)\<rbrakk> \<Longrightarrow>
Mf (l) (p) (([(k,v)] @ k_v_list)) (s)"

end



