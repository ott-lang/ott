/- defns reduce -/
mutual
/-- defn redM -/
inductive redM : delta → M → M → Prop where
  | redMvar : ∀ (delta1 : delta) (vi : ident) (V5 : M) (delta2 : delta),
      (is_V_of_M V5) →
      redM (delta2 ++ (Valbind vi V5) :: delta1) (Var vi) V5

  | redMpath : ∀ (delta5 : delta) (p5 : p) (v : name) (V5 : M) (dV1 : d) (i : stamp) (dV2 : d),
      (is_V_of_M V5) →
      (is_dV_of_d dV1) →
      (is_dV_of_d dV2) →
      (pathDelta delta5 p5 (Strexp (d_append dV1 (Valbind (Id v i) V5) dV2))) →
      redM delta5 (Vpath p5 v) (msubst_M (build_msubst_d p5 dV1) V5)

  | redMapp : ∀ (delta5 : delta) (vi : ident) (T5 : T) (M5 : M) (V5 : M),
      (is_V_of_M V5) →
      (is_V_of_M V5) →
      redM delta5 (Fapp (Fun vi T5 M5) V5) (vsubst_M V5 vi M5)

  | redMlet : ∀ (delta5 : delta) (dV5 : d) (vi : ident) (T5 : T) (M5 : M),
      (is_dV_of_d dV5) →
      redM delta5 (Letexp dV5 (Fun vi T5 M5)) (Fun vi T5 (Letexp dV5 M5))

  | redMapp_ctxt1 : ∀ (delta5 : delta) (M1 : M) (M2 : M) (M3 : M),
      (redM delta5 M1 M3) →
      redM delta5 (Fapp M1 M2) (Fapp M3 M2)

  | redMapp_ctxt2 : ∀ (delta5 : delta) (V5 : M) (M1 : M) (M2 : M),
      (is_V_of_M V5) →
      (redM delta5 M1 M2) →
      redM delta5 (Fapp V5 M1) (Fapp V5 M2)

  | redMlet_ctxt1 : ∀ (delta5 : delta) (d1 : d) (M5 : M) (d2 : d),
      (red_d delta5 d1 d2) →
      redM delta5 (Letexp d1 M5) (Letexp d2 M5)

  | redMlet_ctxt2 : ∀ (delta5 : delta) (dV5 : d) (M1 : M) (M2 : M),
      (is_dV_of_d dV5) →
      (redM (REVERSE (d_to_list dV5) ++ delta5) M1 M2) →
      redM delta5 (Letexp dV5 M1) (Letexp dV5 M2)


/-- defn red_c -/
inductive red_c : delta → c → c → Prop where
  | rec_c_str_ctxt : ∀ (delta5 : delta) (xi : ident) (s1 : s) (s2 : s),
      (red_s delta5 s1 s2) →
      red_c delta5 (Strbind xi s1) (Strbind xi s2)

  | rec_c_val_ctxt : ∀ (delta5 : delta) (vi : ident) (M1 : M) (M2 : M),
      (redM delta5 M1 M2) →
      red_c delta5 (Valbind vi M1) (Valbind vi M2)


/-- defn red_d -/
inductive red_d : delta → d → d → Prop where
  | red_d_d_ctxt1 : ∀ (delta5 : delta) (c1 : c) (d5 : d) (c2 : c),
      (red_c delta5 c1 c2) →
      red_d delta5 (dCons c1 d5) (dCons c2 d5)

  | red_d_d_ctxt2 : ∀ (delta5 : delta) (cV5 : c) (d1 : d) (d2 : d),
      (is_cV_of_c cV5) →
      (red_d (deltaCons delta5 cV5) d1 d2) →
      red_d delta5 (dCons cV5 d1) (dCons cV5 d2)


/-- defn red_s -/
inductive red_s : delta → s → s → Prop where
  | red_s_path : ∀ (delta5 : delta) (p5 : p) (sV5 : s),
      (is_sV_of_s sV5) →
      (pathDelta delta5 p5 sV5) →
      red_s delta5 (Path p5) sV5

  | red_s_ftorapp : ∀ (delta5 : delta) (xi : ident) (S5 : S) (s5 : s) (p5 : p),
      red_s delta5 (Ftorapp (Ftorexp xi S5 s5) p5) (subst_s p5 xi s5)

  | red_s_seal : ∀ (delta5 : delta) (s5 : s) (S5 : S),
      red_s delta5 (Seal s5 S5) s5

  | red_s_str_ctxt : ∀ (delta5 : delta) (d1 : d) (d2 : d),
      (red_d delta5 d1 d2) →
      red_s delta5 (Strexp d1) (Strexp d2)

  | red_s_ftorapp_ctxt : ∀ (delta5 : delta) (s1 : s) (p5 : p) (s2 : s),
      (red_s delta5 s1 s2) →
      red_s delta5 (Ftorapp s1 p5) (Ftorapp s2 p5)


end
