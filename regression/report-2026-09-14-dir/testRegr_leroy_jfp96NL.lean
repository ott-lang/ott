      (formula_notinBV xi E5) →
      (type_s (ECons E5 (Modspec xi S5)) s5 S') →
      type_s E5 (Ftorexp xi S5 s5) (Ftorsig xi S5 S')

  | type_s3 : ∀ (E5 : E) (s5 : s) (p5 : p) (S5 : S) (xi : ident) (S' : S) (S'' : S),
      (type_s E5 s5 (Ftorsig xi S' S5)) →
      (pathE E5 p5 S'') →
      (subS E5 S'' S') →
      type_s E5 (Ftorapp s5 p5) (subst_S p5 xi S5)

  | type_s4 : ∀ (E5 : E) (d5 : d) (D5 : D),
      (type_d E5 d5 D5) →
      type_s E5 (Strexp d5) (Strsig D5)

  | type_s5 : ∀ (E5 : E) (s5 : s) (S1 : S) (S2 : S),
      (WFsig E5 S1) →
      (type_s E5 s5 S2) →
      (subS E5 S2 S1) →
      type_s E5 (Seal s5 S1) S1


/-- defn type_c -/
inductive type_c : E → c → C → Prop where
  | type_c1 : ∀ (E5 : E) (ti : ident) (T5 : T),
      (WFtype E5 T5) →
      (formula_notinBV ti E5) →
      type_c E5 (Typebind ti T5) (Mtyspec ti T5)

  | type_c2 : ∀ (E5 : E) (ti : ident),
      (formula_notinBV ti E5) →
      type_c E5 (Dtype ti) (Otyspec ti)

  | type_c3 : ∀ (E5 : E) (xi : ident) (s5 : s) (S5 : S),
      (type_s E5 s5 S5) →
      (formula_notinBV xi E5) →
      type_c E5 (Strbind xi s5) (Modspec xi S5)

  | type_c4 : ∀ (E5 : E) (vi : ident) (M5 : M) (T5 : T),
      (typeM E5 M5 T5) →
      (formula_notinBV vi E5) →
      type_c E5 (Valbind vi M5) (Valspec vi T5)


/-- defn type_d -/
inductive type_d : E → d → D → Prop where
  | type_d1 : ∀ (E5 : E),
      type_d E5 dNil_d DNil

  | type_d2 : ∀ (E5 : E) (c5 : c) (d5 : d) (C5 : C) (D5 : D),
      (type_c E5 c5 C5) →
      (type_d (ECons E5 C5) d5 D5) →
      type_d E5 (dCons c5 d5) (DCons C5 D5)


/-- defn typeM -/
inductive typeM : E → M → T → Prop where
  | typeM1 : ∀ (E1 : E) (vi : ident) (T5 : T) (E2 : E),
      typeM (E2 ++ (Valspec vi T5) :: E1) (Var vi) T5

  | typeM2 : ∀ (E5 : E) (p5 : p) (v : name) (T5 : T) (D1 : D) (i : stamp) (D2 : D),
      (pathE E5 p5 (Strsig (D_append D1 (Valspec (Id v i) T5) D2))) →
      typeM E5 (Vpath p5 v) (msubst_T (build_msubst_D p5 D1) T5)

  | typeM3 : ∀ (E5 : E) (vi : ident) (T1 : T) (M5 : M) (T2 : T),
      (formula_notinBV vi E5) →
      (WFtype E5 T1) →
      (typeM (ECons E5 (Valspec vi T1)) M5 T2) →
      typeM E5 (Fun vi T1 M5) (Tyarrow T1 T2)

  | typeM4 : ∀ (E5 : E) (M1 : M) (M2 : M) (T2 : T) (T1 : T),
      (typeM E5 M1 (Tyarrow T1 T2)) →
      (typeM E5 M2 T1) →
      typeM E5 (Fapp M1 M2) T2

  | typeM5 : ∀ (E5 : E) (d5 : d) (M5 : M) (T2 : T) (D5 : D) (T1 : T),
      (type_d E5 d5 D5) →
      (typeM (REVERSE (D_to_list D5) ++ E5) M5 T1) →
      (eqT (REVERSE (D_to_list D5) ++ E5) T1 T2) →
      (WFtype E5 T2) →
      typeM E5 (Letexp d5 M5) T2


end
