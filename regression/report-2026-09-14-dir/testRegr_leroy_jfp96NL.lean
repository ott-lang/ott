/- defns deltaE -/
/-- defn deltaE -/
inductive deltaE : delta → E → Prop where
  | deltaE1 :       deltaE deltaNil ENil

  | deltaE2 : ∀ (delta5 : delta) (cV5 : c) (E5 : E) (C5 : C),
      (is_cV_of_c cV5) →
      (deltaE delta5 E5) →
      (type_c E5 cV5 C5) →
      deltaE (deltaCons delta5 cV5) (ECons E5 C5)



