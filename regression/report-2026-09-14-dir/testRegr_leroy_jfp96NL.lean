/- defns pathDelta -/
/-- defn pathDelta -/
inductive pathDelta : delta → p → s → Prop where
  | pathDelta1 : ∀ (delta1 : delta) (xi : ident) (s5 : s) (delta2 : delta),
      pathDelta (delta2 ++ (Strbind xi s5) :: delta1) (Mid xi) (sstrengthen s5 (Mid xi))

  | pathDelta2 : ∀ (delta5 : delta) (p5 : p) (x : name) (s5 : s) (d1 : d) (i : stamp) (d2 : d),
      (pathDelta delta5 p5 (Strexp (d_append d1 (Strbind (Id x i) s5) d2))) →
      pathDelta delta5 (Mpath p5 x) (msubst_s (build_msubst_d p5 d1) s5)

