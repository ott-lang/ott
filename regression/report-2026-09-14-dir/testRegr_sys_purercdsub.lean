/-- defn typing -/
inductive typing : G → t → T → Prop where
  | T_Var : ∀ (G5 : G) (x : termvar) (T5 : T),
      (bound x T5 G5) →
      typing G5 (TmVar x) T5

  | T_Abs : ∀ (G5 : G) (x : termvar) (T1 : T) (t2 : t) (T2 : T),
      (typing (G_vn G5 x T1) t2 T2) →
      typing G5 (TmAbs x T1 t2) (TyArr T1 T2)

  | T_App : ∀ (G5 : G) (t1 : t) (t2 : t) (T12 : T) (T11 : T),
      (typing G5 t1 (TyArr T11 T12)) →
      (typing G5 t2 T11) →
      typing G5 (TmApp t1 t2) T12

  | T_Sub : ∀ (G5 : G) (t5 : t) (T5 : T) (S : T),
      (typing G5 t5 S) →
      (subtyping S T5) →
      typing G5 t5 T5

  | T_Rcd : ∀ (l_t_T_list : list_label_t_T) (G5 : G),
      (∀ l_t_T_list_ ∈ (unmake_list_label_t_T l_t_T_list), (fun (l_,t_,T_) => (typing G5 t_ T_)) l_t_T_list_) →
      (List.Nodup (unmake_list_label (make_list_label (map_list_label_t_T (fun l_ t_ T_ => l_) l_t_T_list)))) →
      typing G5 (TmRecord (make_list_label_t (map_list_label_t_T (fun l_ t_ T_ => (l_,t_)) l_t_T_list))) (TyRecord (make_list_label_T (map_list_label_t_T (fun l_ t_ T_ => (l_,T_)) l_t_T_list)))

  | T_Proj : ∀ (l_T_list : list_label_T) (j : index) (G5 : G) (t1 : t),
      (typing G5 t1 (TyRecord l_T_list)) →
      typing G5 (TmProj t1 ((fun (l_,T_) => l_) ((unmake_list_label_T l_T_list)[j - 1]!))) ((fun (l_,T_) => T_) ((unmake_list_label_T l_T_list)[j - 1]!))


/-- defn subtyping -/
inductive subtyping : T → T → Prop where
  | S_Refl : ∀ (S : T),
      subtyping S S

  | S_Trans : ∀ (S : T) (T5 : T) (U : T),
      (subtyping S U) →
      (subtyping U T5) →
      subtyping S T5

  | S_Arrow : ∀ (S1 : T) (S2 : T) (T1 : T) (T2 : T),
      (subtyping T1 S1) →
      (subtyping S2 T2) →
      subtyping (TyArr S1 S2) (TyArr T1 T2)

  | S_Top : ∀ (S : T),
      subtyping S TyTop

  | S_RcdWidth : ∀ (l'_T'_list : list_label_T) (l_T_list : list_label_T),
      subtyping (TyRecord ((app_list_label_T l_T_list (app_list_label_T l'_T'_list Nil_list_label_T)))) (TyRecord l_T_list)

  | S_RcdDepth : ∀ (l_S_T_list : list_label_T_T),
      (∀ l_S_T_list_ ∈ (unmake_list_label_T_T l_S_T_list), (fun (l_,S_,T_) => (subtyping S_ T_)) l_S_T_list_) →
      subtyping (TyRecord (make_list_label_T (map_list_label_T_T (fun l_ S_ T_ => (l_,S_)) l_S_T_list))) (TyRecord (make_list_label_T (map_list_label_T_T (fun l_ S_ T_ => (l_,T_)) l_S_T_list)))

  | S_RcdPerm : ∀ (l_T_list : list_label_T) (k_S_list : list_label_T),
      (TODO) →
      subtyping (TyRecord k_S_list) (TyRecord l_T_list)


