( (forall  i . (1<= i  &&  i  <= m) -->  Mf  ((fun (l_,p_,s_) -> l_) (List.nth  l_p_s_list (i - 1) ))   ((fun (l_,p_,s_) -> p_) (List.nth  l_p_s_list (i - 1) ))  (k_v_list)  ((fun (l_,p_,s_) -> s_) (List.nth  l_p_s_list (i - 1) ))  ) )
 ==> 
M (P_Rec ((List.map (fun (l_,p_,s_) -> (l_,p_)) l_p_s_list))) (T_Rec (k_v_list))  (List.flatten  ((List.map (fun (l_,p_,s_) -> s_) l_p_s_list)) ) 


and
(* defn Mf *)

Mf_found: forall k_v_list l p v s .
(is_v_of_t v) &&
(List.all (fun (k_,v_) -> is_v_of_t v_) k_v_list) &&
(M p v s)
 ==> 
Mf l p ([(l,v)] ++ k_v_list) s

and
Mf_skip: forall k_v_list l p k v s .
(is_v_of_t v) &&
(List.all (fun (k_,v_) -> is_v_of_t v_) k_v_list) &&
(Mf l p (k_v_list) s)
 ==> 
Mf l p ([(k,v)] ++ k_v_list) s




