(List.all (fun (l_,v_) -> is_v_of_t v_) l_v_list) &&
(reduce t t')
 ==> 
reduce (T_Rec (l_v_list ++ [(l,t)] ++ l'_t'_list)) (T_Rec (l_v_list ++ [(l,t')] ++ l'_t'_list))

and
reduce_Ctx_let_binding: forall p t1 t2 t1' .
(reduce t1 t1')
 ==> 
reduce (T_Let p t1 t2) (T_Let p t1' t2)


