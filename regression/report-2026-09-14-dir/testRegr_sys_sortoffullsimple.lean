/-- defn red -/
inductive red : t → t → Prop where
  | E_App1 : ∀ (t1 : t) (t2 : t) (t1' : t),
      (red t1 t1') →
      red (TmApp t1 t2) (TmApp t1' t2)

  | E_App2 : ∀ (v1 : t) (t2 : t) (t2' : t),
      (is_v_of_t v1) →
      (red t2 t2') →
      red (TmApp v1 t2) (TmApp v1 t2')

  | E_AppAbs : ∀ (x : termvar) (T5 : T) (t12 : t) (v2 : t),
      (is_v_of_t v2) →
      red (TmApp (TmAbs x T5 t12) v2) (subst_t v2 x t12)

  | E_IfTrue : ∀ (t2 : t) (t3 : t),
      red (TmIf TmTrue t2 t3) t2

  | E_IfFalse : ∀ (t2 : t) (t3 : t),
      red (TmIf TmFalse t2 t3) t3

  | E_If : ∀ (t1 : t) (t2 : t) (t3 : t) (t1' : t),
      (red t1 t1') →
      red (TmIf t1 t2 t3) (TmIf t1' t2 t3)

  | E_Succ : ∀ (t1 : t) (t1' : t),
      (red t1 t1') →
      red (TmSucc t1) (TmSucc t1')

  | E_PredZero :       red (TmPred TmZero) TmZero

  | E_PredSucc : ∀ (v1 : t),
      (is_v_of_t v1) →
      red (TmPred (TmSucc v1)) v1

  | E_Pred : ∀ (t1 : t) (t1' : t),
      (red t1 t1') →
      red (TmPred t1) (TmPred t1')

  | E_IsZeroZero :       red (TmIszero TmZero) TmTrue

  | E_IsZeroSucc : ∀ (v1 : t),
      (is_v_of_t v1) →
      red (TmIszero (TmSucc v1)) TmFalse

  | E_IsZero : ∀ (t1 : t) (t1' : t),
      (red t1 t1') →
      red (TmIszero t1) (TmIszero t1')

  | E_Seq : ∀ (t1 : t) (t2 : t) (t1' : t),
      (red t1 t1') →
      red (TmSeq t1 t2) (TmSeq t1' t2)

  | E_SeqNext : ∀ (t2 : t),
      red (TmSeq TmUnit t2) t2

  | E_Ascribe : ∀ (v1 : t) (T5 : T),
      (is_v_of_t v1) →
      red (TmAscribe v1 T5) v1

  | E_Ascribe1 : ∀ (t1 : t) (T5 : T) (t1' : t),
      (red t1 t1') →
      red (TmAscribe t1 T5) (TmAscribe t1' T5)

  | E_LetV : ∀ (x : termvar) (v1 : t) (t2 : t),
      (is_v_of_t v1) →
      red (TmLet x v1 t2) (subst_t v1 x t2)

  | E_Let : ∀ (x : termvar) (t1 : t) (t2 : t) (t1' : t),
      (red t1 t1') →
      red (TmLet x t1 t2) (TmLet x t1' t2)

  | E_CaseInl : ∀ (v0 : t) (x1 : termvar) (t1 : t) (x2 : termvar) (t2 : t),
      (is_v_of_t v0) →
      red (TmCaseSm (TmInl v0) x1 t1 x2 t2) (subst_t v0 x1 t1)

  | E_CaseInr : ∀ (v0 : t) (x1 : termvar) (t1 : t) (x2 : termvar) (t2 : t),
      (is_v_of_t v0) →
      red (TmCaseSm (TmInr v0) x1 t1 x2 t2) (subst_t v0 x2 t2)

  | E_CaseSm : ∀ (t0 : t) (x1 : termvar) (t1 : t) (x2 : termvar) (t2 : t) (t0' : t),
      (red t0 t0') →
      red (TmCaseSm t0 x1 t1 x2 t2) (TmCaseSm t0' x1 t1 x2 t2)

  | E_Inl : ∀ (t1 : t) (t1' : t),
      (red t1 t1') →
      red (TmInl t1) (TmInl t1')

  | E_Inr : ∀ (t1 : t) (t1' : t),
      (red t1 t1') →
      red (TmInr t1) (TmInr t1')

  | E_CaseVariant : ∀ (l_x_t_list : list_label_termvar_t) (v5 : t) (T5 : T) (j : index),
      (is_v_of_t v5) →
      (1 <= j ∧ j <= List.length (unmake_list_t (make_list_t (map_list_label_termvar_t (fun l_ x_ t_ => t_) l_x_t_list)))) →
      red (TmCase (TmVariant ((fun (l_,x_,t_) => l_) ((unmake_list_label_termvar_t l_x_t_list)[j - 1]!)) v5 T5) (make_list_C (map_list_label_termvar_t (fun l_ x_ t_ => (CCase l_ x_ t_)) l_x_t_list))) (subst_t v5 ((fun (l_,x_,t_) => x_) ((unmake_list_label_termvar_t l_x_t_list)[j - 1]!)) ((fun (l_,x_,t_) => t_) ((unmake_list_label_termvar_t l_x_t_list)[j - 1]!)))

  | E_Case : ∀ (l_x_t_list : list_label_termvar_t) (t_5 : t) (t' : t),
      (red t_5 t') →
      red (TmCase t_5 (make_list_C (map_list_label_termvar_t (fun l_ x_ t_ => (CCase l_ x_ t_)) l_x_t_list))) (TmCase t' (make_list_C (map_list_label_termvar_t (fun l_ x_ t_ => (CCase l_ x_ t_)) l_x_t_list)))

  | E_Variant : ∀ (li : label) (ti : t) (T5 : T) (ti' : t),
      (red ti ti') →
      red (TmVariant li ti T5) (TmVariant li ti' T5)

  | E_PairBeta1 : ∀ (v1 : t) (v2 : t),
      (is_v_of_t v1) →
      (is_v_of_t v2) →
      red (TmProj1 (TmPair v1 v2)) v1

  | E_PairBeta2 : ∀ (v1 : t) (v2 : t),
      (is_v_of_t v1) →
      (is_v_of_t v2) →
      red (TmProj2 (TmPair v1 v2)) v2

  | E_Proj1 : ∀ (t1 : t) (t1' : t),
      (red t1 t1') →
      red (TmProj1 t1) (TmProj1 t1')

  | E_Proj2 : ∀ (t1 : t) (t1' : t),
      (red t1 t1') →
      red (TmProj2 t1) (TmProj2 t1')

  | E_Pair1 : ∀ (t1 : t) (t2 : t) (t1' : t),
      (red t1 t1') →
      red (TmPair t1 t2) (TmPair t1' t2)

  | E_Pair2 : ∀ (v1 : t) (t2 : t) (t2' : t),
      (is_v_of_t v1) →
      (red t2 t2') →
      red (TmPair v1 t2) (TmPair v1 t2')

  | E_ProjTuple : ∀ (v_list : list_t) (j : index),
      (List.all (unmake_list_t v_list) (fun v_ => is_v_of_t v_)) →
      (1 <= j ∧ j <= List.length (unmake_list_t v_list)) →
      red (TmProjTp (TmTuple v_list) j) ((fun v_ => v_) ((unmake_list_t v_list)[j - 1]!))

  | E_ProjTp : ∀ (t1 : t) (i : index) (t1' : t),
      (red t1 t1') →
      red (TmProjTp t1 i) (TmProjTp t1' i)

  | E_Tuple : ∀ (t_list : list_t) (v_list : list_t) (t_5 : t) (t' : t),
      (List.all (unmake_list_t v_list) (fun v_ => is_v_of_t v_)) →
      (red t_5 t') →
      red (TmTuple ((app_list_t v_list (app_list_t (Cons_list_t t_5 Nil_list_t) (app_list_t t_list Nil_list_t))))) (TmTuple ((app_list_t v_list (app_list_t (Cons_list_t t' Nil_list_t) (app_list_t t_list Nil_list_t)))))

  | E_ProjRcd : ∀ (l_v_list : list_label_t) (j : index),
      (List.all (unmake_list_label_t l_v_list) (fun (l_,v_) => is_v_of_t v_)) →
      red (TmProj (TmRecord l_v_list) ((fun (l_,v_) => l_) ((unmake_list_label_t l_v_list)[j - 1]!))) ((fun (l_,v_) => v_) ((unmake_list_label_t l_v_list)[j - 1]!))

  | E_Proj : ∀ (t1 : t) (l : label) (t1' : t),
      (red t1 t1') →
      red (TmProj t1 l) (TmProj t1' l)

  | E_Rcd : ∀ (l'_t_list : list_label_t) (l_v_list : list_label_t) (l : label) (t_5 : t) (t' : t),
      (List.all (unmake_list_label_t l_v_list) (fun (l_,v_) => is_v_of_t v_)) →
      (red t_5 t') →
      red (TmRecord ((app_list_label_t l_v_list (app_list_label_t (Cons_list_label_t l t_5 Nil_list_label_t) (app_list_label_t l'_t_list Nil_list_label_t))))) (TmRecord ((app_list_label_t l_v_list (app_list_label_t (Cons_list_label_t l t' Nil_list_label_t) (app_list_label_t l'_t_list Nil_list_label_t)))))

  | E_FixBeta : ∀ (x : termvar) (T1 : T) (t2 : t),
      red (TmFix (TmAbs x T1 t2)) (subst_t (TmFix (TmAbs x T1 t2)) x t2)

  | E_Fix : ∀ (t1 : t) (t1' : t),
      (red t1 t1') →
      red (TmFix t1) (TmFix t1')


/- defns Jtype -/
/-- defn typing -/
inductive typing : G → t → T → Prop where
  | T_Var : ∀ (G5 : G) (x : termvar) (T5 : T),
      (bound x T5 G5) →
      typing G5 (TmVar x) T5

  | T_Abs : ∀ (G5 : G) (x : termvar) (T1 : T) (t2 : t) (T2 : T),
      (typing (G_vn G5 x T1) t2 T2) →
      typing G5 (TmAbs x T1 t2) (TyArr T1 T2)

  | T_App : ∀ (G5 : G) (t1 : t) (t2 : t) (T12 : T) (T11 : T),
      (typing G5 t1 (TyArr T11 T12)) →
      (typing G5 t2 T11) →
      typing G5 (TmApp t1 t2) T12

  | T_True : ∀ (G5 : G),
      typing G5 TmTrue TyBool

  | T_False : ∀ (G5 : G),
      typing G5 TmFalse TyBool

  | T_If : ∀ (G5 : G) (t1 : t) (t2 : t) (t3 : t) (T5 : T),
      (typing G5 t1 TyBool) →
      (typing G5 t2 T5) →
      (typing G5 t3 T5) →
      typing G5 (TmIf t1 t2 t3) T5

  | T_Zero : ∀ (G5 : G),
      typing G5 TmZero TyNat

  | T_Succ : ∀ (G5 : G) (t1 : t),
      (typing G5 t1 TyNat) →
      typing G5 (TmSucc t1) TyNat

  | T_Pred : ∀ (G5 : G) (t1 : t),
      (typing G5 t1 TyNat) →
      typing G5 (TmPred t1) TyNat

  | T_IsZero : ∀ (G5 : G) (t1 : t),
      (typing G5 t1 TyNat) →
      typing G5 (TmIszero t1) TyBool

  | T_Unit : ∀ (G5 : G),
      typing G5 TmUnit TyUnit

  | T_Seq : ∀ (G5 : G) (t1 : t) (t2 : t) (T2 : T),
      (typing G5 t1 TyUnit) →
      (typing G5 t2 T2) →
      typing G5 (TmSeq t1 t2) T2

  | T_Ascribe : ∀ (G5 : G) (t1 : t) (T5 : T),
      (typing G5 t1 T5) →
      typing G5 (TmAscribe t1 T5) T5

  | T_Inert : ∀ (G5 : G) (T5 : T),
      typing G5 (TmInert T5) T5

  | T_Let : ∀ (G5 : G) (x : termvar) (t1 : t) (t2 : t) (T2 : T) (T1 : T),
      (typing G5 t1 T1) →
      (typing (G_vn G5 x T1) t2 T2) →
      typing G5 (TmLet x t1 t2) T2

  | T_Inl : ∀ (G5 : G) (t1 : t) (T1 : T) (T2 : T),
      (typing G5 t1 T1) →
      typing G5 (TmInl t1) (TySum T1 T2)

  | T_Inr : ∀ (G5 : G) (t1 : t) (T1 : T) (T2 : T),
      (typing G5 t1 T2) →
      typing G5 (TmInr t1) (TySum T1 T2)

  | T_CaseSm : ∀ (G5 : G) (t0 : t) (x1 : termvar) (t1 : t) (x2 : termvar) (t2 : t) (T_5 : T) (T1 : T) (T2 : T),
      (typing G5 t0 (TySum T1 T2)) →
      (typing (G_vn G5 x1 T1) t1 T_5) →
      (typing (G_vn G5 x2 T2) t2 T_5) →
      typing G5 (TmCaseSm t0 x1 t1 x2 t2) T_5

  | T_Variant : ∀ (l_T_list : list_label_T) (G5 : G) (t5 : t) (j : index),
      (typing G5 t5 ((fun (l_,T_) => T_) ((unmake_list_label_T l_T_list)[j - 1]!))) →
      (1 <= j ∧ j <= List.length (unmake_list_T (make_list_T (map_list_label_T (fun l_ T_ => T_) l_T_list)))) →
      typing G5 (TmVariant ((fun (l_,T_) => l_) ((unmake_list_label_T l_T_list)[j - 1]!)) t5 (TyVariant l_T_list)) (TyVariant l_T_list)

  | T_Case : ∀ (l_x_t_T_list : list_label_termvar_t_T) (G5 : G) (t_5 : t) (T_5 : T),
      (typing G5 t_5 (TyVariant (make_list_label_T (map_list_label_termvar_t_T (fun l_ x_ t_ T_ => (l_,T_)) l_x_t_T_list)))) →
      (∀ l_x_t_T_list_ ∈ (unmake_list_label_termvar_t_T l_x_t_T_list), (fun (l_,x_,t_,T_) => (typing (G_vn G5 x_ T_) t_ T_5)) l_x_t_T_list_) →
      (List.Nodup (unmake_list_label (make_list_label (map_list_label_termvar_t_T (fun l_ x_ t_ T_ => l_) l_x_t_T_list)))) →
      typing G5 (TmCase t_5 (make_list_C (map_list_label_termvar_t_T (fun l_ x_ t_ T_ => (CCase l_ x_ t_)) l_x_t_T_list))) T_5

  | T_Pair : ∀ (G5 : G) (t1 : t) (t2 : t) (T1 : T) (T2 : T),
      (typing G5 t1 T1) →
      (typing G5 t2 T2) →
      typing G5 (TmPair t1 t2) (TyPair T1 T2)

  | T_Proj1 : ∀ (G5 : G) (t1 : t) (T1 : T) (T2 : T),
      (typing G5 t1 (TyPair T1 T2)) →
      typing G5 (TmProj1 t1) T1

  | T_Proj2 : ∀ (G5 : G) (t1 : t) (T2 : T) (T1 : T),
      (typing G5 t1 (TyPair T1 T2)) →
      typing G5 (TmProj2 t1) T2

  | T_Tuple : ∀ (t_T_list : list_t_T) (G5 : G),
      (∀ t_T_list_ ∈ (unmake_list_t_T t_T_list), (fun (t_,T_) => (typing G5 t_ T_)) t_T_list_) →
      typing G5 (TmTuple (make_list_t (map_list_t_T (fun t_ T_ => t_) t_T_list))) (TyTuple (make_list_T (map_list_t_T (fun t_ T_ => T_) t_T_list)))

  | T_ProjTp : ∀ (T_list : list_T) (G5 : G) (t1 : t) (j : index),
      (typing G5 t1 (TyTuple T_list)) →
      (1 <= j ∧ j <= List.length (unmake_list_T T_list)) →
      typing G5 (TmProjTp t1 j) ((fun T_ => T_) ((unmake_list_T T_list)[j - 1]!))

  | T_Rcd : ∀ (l_t_T_list : list_label_t_T) (G5 : G),
      (∀ l_t_T_list_ ∈ (unmake_list_label_t_T l_t_T_list), (fun (l_,t_,T_) => (typing G5 t_ T_)) l_t_T_list_) →
      (List.Nodup (unmake_list_label (make_list_label (map_list_label_t_T (fun l_ t_ T_ => l_) l_t_T_list)))) →
      typing G5 (TmRecord (make_list_label_t (map_list_label_t_T (fun l_ t_ T_ => (l_,t_)) l_t_T_list))) (TyRecord (make_list_label_T (map_list_label_t_T (fun l_ t_ T_ => (l_,T_)) l_t_T_list)))

  | T_Proj : ∀ (l_T_list : list_label_T) (j : index) (G5 : G) (t1 : t),
      (typing G5 t1 (TyRecord l_T_list)) →
      typing G5 (TmProj t1 ((fun (l_,T_) => l_) ((unmake_list_label_T l_T_list)[j - 1]!))) ((fun (l_,T_) => T_) ((unmake_list_label_T l_T_list)[j - 1]!))

  | T_Fix : ∀ (G5 : G) (t1 : t) (T1 : T),
      (typing G5 t1 (TyArr T1 T1)) →
      typing G5 (TmFix t1) T1



