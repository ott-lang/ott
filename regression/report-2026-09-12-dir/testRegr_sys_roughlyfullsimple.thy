typing (G) ((TmSeq t1 t2)) (T2)"

| T_AscribeI: "\<lbrakk>typing (G) (t1) (T)\<rbrakk> \<Longrightarrow>
typing (G) ((TmAscribe t1 T)) (T)"

| T_LetI: "\<lbrakk>typing (G) (t1) (T1) ;
typing ( ( x , T1 )# G ) (t2) (T2)\<rbrakk> \<Longrightarrow>
typing (G) ((TmLet x t1 t2)) (T2)"

| T_PairI: "\<lbrakk>typing (G) (t1) (T1) ;
typing (G) (t2) (T2)\<rbrakk> \<Longrightarrow>
typing (G) ((TmPair t1 t2)) ((TyPair T1 T2))"

| T_Proj1I: "\<lbrakk>typing (G) (t1) ((TyPair T1 T2))\<rbrakk> \<Longrightarrow>
typing (G) ((TmProj1 t1)) (T1)"

| T_Proj2I: "\<lbrakk>typing (G) (t1) ((TyPair T1 T2))\<rbrakk> \<Longrightarrow>
typing (G) ((TmProj2 t1)) (T2)"

| T_InlI: "\<lbrakk>typing (G) (t1) (T1)\<rbrakk> \<Longrightarrow>
typing (G) ((TmInl t1)) ((TySum T1 T2))"

| T_InrI: "\<lbrakk>typing (G) (t1) (T2)\<rbrakk> \<Longrightarrow>
typing (G) ((TmInr t1)) ((TySum T1 T2))"

| T_CaseSmI: "\<lbrakk>typing (G) (t0) ((TySum T1 T2)) ;
typing ( ( x1 , T1 )# G ) (t1) (T) ;
typing ( ( x2 , T2 )# G ) (t2) (T)\<rbrakk> \<Longrightarrow>
typing (G) ((TmCaseSm t0 x1 t1 x2 t2)) (T)"

| T_FixI: "\<lbrakk>typing (G) (t1) ((TyArr T1 T1))\<rbrakk> \<Longrightarrow>
typing (G) ((TmFix t1)) (T1)"

| T_TupleI: "\<lbrakk>(List.list_all (% b . b) ((List.map (%((t_XXX::t),(T_XXX::T)).typing (G) (t_XXX) (T_XXX)) t_T_list)))\<rbrakk> \<Longrightarrow>
typing (G) ((TmTuple ((List.map (%((t_XXX::t),(T_XXX::T)).t_XXX) t_T_list)))) ((TyTuple ((List.map (%((t_XXX::t),(T_XXX::T)).T_XXX) t_T_list))))"

| T_ProjTpI: "\<lbrakk>typing (G) (t1) ((TyTuple (T_list))) ;
 (1 <=  j  &  j  <= length  (T_list) ) \<rbrakk> \<Longrightarrow>
typing (G) ((TmProjTp t1 j)) (((%T_XXX . T_XXX) (List.nth T_list (j - 1))))"

| T_VariantI: "\<lbrakk>typing (G) (t) (((%(l_XXX,T_XXX) . T_XXX) (List.nth l_T_list (j - 1)))) ;
 (1 <=  j  &  j  <= length  ((List.map (%((l_XXX::label),(T_XXX::T)).T_XXX) l_T_list)) ) \<rbrakk> \<Longrightarrow>
typing (G) ((TmVariant ((%(l_XXX,T_XXX) . l_XXX) (List.nth l_T_list (j - 1))) t (TyVariant (l_T_list)))) ((TyVariant (l_T_list)))"

| T_CaseI: "\<lbrakk>typing (G) (t) ((TyVariant ((List.map (%((l_XXX::label),(x_XXX::termvar),(t_XXX::t),(T_XXX::T)).(l_XXX,T_XXX)) l_x_t_T_list)))) ;
(List.list_all (% b . b) ((List.map (%((l_XXX::label),(x_XXX::termvar),(t_XXX::t),(T_XXX::T)).typing ( ( x_XXX , T_XXX )# G ) (t_XXX) (T)) l_x_t_T_list))) ;
 (distinct  ((List.map (%((l_XXX::label),(x_XXX::termvar),(t_XXX::t),(T_XXX::T)).l_XXX) l_x_t_T_list)) ) \<rbrakk> \<Longrightarrow>
typing (G) ((TmCase t ((List.map (%((l_XXX::label),(x_XXX::termvar),(t_XXX::t),(T_XXX::T)).(CCase l_XXX x_XXX t_XXX)) l_x_t_T_list)))) (T)"



