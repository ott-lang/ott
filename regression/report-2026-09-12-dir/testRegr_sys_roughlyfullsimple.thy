| T_VarI: "\<lbrakk> ? G1 G2.  G  = G1 @ ( x , T )#G2 &  x ~:fst ` set G1 \<rbrakk> \<Longrightarrow>
typing (G) ((TmVar x)) (T)"

| T_AbsI: "\<lbrakk>typing ( ( x , T1 )# G ) (t2) (T2)\<rbrakk> \<Longrightarrow>
typing (G) ((TmAbs x T1 t2)) ((TyArr T1 T2))"

| T_AppI: "\<lbrakk>typing (G) (t1) ((TyArr T11 T12)) ;
typing (G) (t2) (T11)\<rbrakk> \<Longrightarrow>
typing (G) ((TmApp t1 t2)) (T12)"

| T_UnitI: "typing (G) (TmUnit) (TyUnit)"

| T_SeqI: "\<lbrakk>typing (G) (t1) (TyUnit) ;
