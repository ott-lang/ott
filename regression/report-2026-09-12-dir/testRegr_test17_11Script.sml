( ( Pat (P_Var x Typ) Typ (G_term G_empty x Typ) )))

[Pat_Rcd:] (! (l_p_Typ_D_list:(label#p#T#G) list) .
(clause_name "Pat_Rcd") /\
(((EVERY (\ b . b) ((MAP (\(l_,p_,Typ_,D_) .  ( Pat p_ Typ_ D_ )) l_p_Typ_D_list)))))
 ==> 
( ( Pat (P_Rec ((MAP (\(l_,p_,Typ_,D_) . (l_,p_)) l_p_Typ_D_list))) (T_Rec ((MAP (\(l_,p_,Typ_,D_) . (l_,Typ_)) l_p_Typ_D_list)))  (flatten_G  ((MAP (\(l_,p_,Typ_,D_) . D_) l_p_Typ_D_list)) )  )))
End
