[M_Rcd:] (! (l_p_s_list:(label#p#s) list) (k_v_list:(label#t) list) (i:index) (m:index) (j:index) (n:index) .
(clause_name "M_Rcd") /\
((EVERY (\(k_,v_). is_v_of_t v_) k_v_list) /\
( ! i  . (1<= i  /\  i <= m ) ==>   ? j  . (1<= j  /\  j <= n ) ==>   (   (  (  ((\ (l_,p_,s_) . l_) (EL  (i) l_p_s_list))  =  ((\ (k_,v_) . k_) (EL  (j) k_v_list))  )   /\   ( M  ((\ (l_,p_,s_) . p_) (EL  (i) l_p_s_list))   ((\ (k_,v_) . v_) (EL  (j) k_v_list))   ((\ (l_,p_,s_) . s_) (EL  (i) l_p_s_list))  ) )   )   ))
 ==> 
( ( M (P_Rec ((MAP (\(l_,p_,s_) . (l_,p_)) l_p_s_list))) (t_Rec (k_v_list))  (FLAT  ((MAP (\(l_,p_,s_) . s_) l_p_s_list)) )  )))
