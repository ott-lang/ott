[subD3:] (! (E:E) (C:C) (D:D) (D':D) .
(clause_name "subD3") /\
(( ( subD  ( C  ::  E )  D D' )))
 ==> 
( ( subD E (DCons C D) D' )))

(* defn subC *)

[subC1:] (! (E:E) (ti:ident) .
(clause_name "subC1")
 ==> 
( ( subC E  (Otyspec ti)   (Otyspec ti)  )))

[subC2:] (! (E:E) (ti:ident) (Ty:T) .
(clause_name "subC2")
