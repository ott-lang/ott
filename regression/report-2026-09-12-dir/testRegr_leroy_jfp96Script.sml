[pathDelta2:] (! (delta:delta) (p:p) (x:name) (s:s) (d1:d) (i:stamp) (d2:d) .
(clause_name "pathDelta2") /\
(( ( pathDelta delta p (Strexp  (d_append  d1   (Strbind (Id x i) s)   d2 ) ) )))
 ==> 
( ( pathDelta delta (Mpath p x)  (msubst_s (build_msubst_d  p   d1 )  s )  )))
End
