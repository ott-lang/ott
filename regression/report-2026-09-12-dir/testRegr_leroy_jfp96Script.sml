[redMapp:] (! (delta:delta) (vi:ident) (Ty:T) (M:M) (V:M) .
(clause_name "redMapp") /\
((is_V_of_M V) /\
(is_V_of_M V))
 ==> 
( ( redM delta (Fapp  (Fun vi Ty M)  V)  (vsubst_M  V   vi   M )  )))

[redMlet:] (! (delta:delta) (dV:d) (vi:ident) (Ty:T) (M:M) .
(clause_name "redMlet") /\
((is_dV_of_d dV))
 ==> 
