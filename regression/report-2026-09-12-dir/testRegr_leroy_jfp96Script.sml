[red_d_d_ctxt1:] (! (delta:delta) (c1:c) (d:d) (c2:c) .
(clause_name "red_d_d_ctxt1") /\
(( ( red_c delta c1 c2 )))
 ==> 
( ( red_d delta (dCons c1 d) (dCons c2 d) )))

[red_d_d_ctxt2:] (! (delta:delta) (cV:c) (d1:d) (d2:d) .
