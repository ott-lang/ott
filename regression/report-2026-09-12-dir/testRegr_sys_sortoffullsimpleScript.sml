( ( red (TmFix  (TmAbs x Typ1 t2) )  (subst_t   (TmFix  (TmAbs x Typ1 t2) )    x   t2 )  )))

[E_Fix:] (! (t1:t) (t1':t) .
(clause_name "E_Fix") /\
(( ( red t1 t1' )))
 ==> 
( ( red (TmFix t1) (TmFix t1') )))
End

