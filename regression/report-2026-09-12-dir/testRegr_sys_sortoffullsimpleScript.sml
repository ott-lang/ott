[T_Fix:] (! (G:G) (t1:t) (Typ1:T) .
(clause_name "T_Fix") /\
(( ( typing G t1 (TyArr Typ1 Typ1) )))
 ==> 
( ( typing G (TmFix t1) Typ1 )))
End



