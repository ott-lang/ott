[T_Rcd:] (! (l_t_Typ_list:(label#t#T) list) (G:G) .
(clause_name "T_Rcd") /\
(((EVERY (\ b . b) ((MAP (\(l_,t_,Typ_) .  ( typing G t_ Typ_ )) l_t_Typ_list)))) /\
( (ALL_DISTINCT  ((MAP (\(l_,t_,Typ_) . l_) l_t_Typ_list)) ) ))
 ==> 
( ( typing G (TmRecord ((MAP (\(l_,t_,Typ_) . (l_,t_)) l_t_Typ_list))) (TyRecord ((MAP (\(l_,t_,Typ_) . (l_,Typ_)) l_t_Typ_list))) )))

[T_Proj:] (! (l_Typ_list:(label#T) list) (j:index) (G:G) (t1:t) .
(clause_name "T_Proj") /\
(( ( typing G t1 (TyRecord (l_Typ_list)) )))
 ==> 
