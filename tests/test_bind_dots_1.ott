%% Check what happens if the user writes the wrong number of dots in a
%% bindspec.
indexvar i , j , k , l , m , n ::= {{ lean Nat }} {{ coq nat }} {{ isa nat }} {{ hol num }}
metavar x ::= {{ lean Nat }} {{ coq nat }} {{ isa nat }} {{ hol num }}
grammar
thingy :: thingy_ ::=
foo :: foo_ ::=
  | x1 ... xn thingy :: :: xs (+ bind x1..xn in thingy +)
